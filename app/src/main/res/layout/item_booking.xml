<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBkCustomer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBkStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_free"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/status_free_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/tvBkPitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_sports_soccer"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:drawableTint="@color/primary" />

        <TextView
            android:id="@+id/tvBkDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawableStart="@drawable/ic_event"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:drawableTint="@color/primary" />

        <TextView
            android:id="@+id/tvBkTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawableStart="@drawable/ic_schedule"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:drawableTint="@color/primary" />

        <TextView
            android:id="@+id/tvBkTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawableStart="@drawable/ic_payments"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold"
            app:drawableTint="@color/accent" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
